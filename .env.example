# Local runtime
NODE_ENV=development
AUTH_LOCAL_CODE_DELIVERY=true
LOG_LEVEL=info
PORT=3000
DATABASE_URL=postgresql://yingchuan:yingchuan_local_only@127.0.0.1:55432/yingchuan?schema=public
TEST_DATABASE_URL=postgresql://yingchuan_test:yingchuan_test_local_only@127.0.0.1:55433/yingchuan_test?schema=public
REDIS_URL=redis://:yingchuan_local_only@127.0.0.1:56379/0
# npm workspace processes run from apps/api or apps/worker.
PRIVATE_FILE_ROOT=../../storage/private
ADMIN_ALLOWED_EMAILS=geyaovip@163.com
AUTH_PEPPER=replace_with_at_least_32_random_characters
AUTH_RATE_LIMIT_PREFIX=yingchuan:auth-rate
RESEND_API_KEY=development_only_replace_with_resend_key
MODEL_CREDENTIAL_MASTER_KEY=replace_with_at_least_32_random_characters
MODEL_CREDENTIAL_KEY_VERSION=server-v1
OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
OPENCLAW_GATEWAY_TOKEN=development_only_replace_with_random_token
OPENCLAW_RUNTIME_VERSION=2026.7.1
# 生产 production.env 必须改为官方 2026.7.1 镜像的 sha256 摘要。
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1
NOTIFICATION_CREDENTIAL_MASTER_KEY=replace_with_at_least_32_random_characters
NOTIFICATION_CREDENTIAL_KEY_VERSION=server-v1

# Production deployment safety defaults. Keep these in production.env, not in secret files.
DEPLOY_MIN_FREE_DISK_MB=10240
DEPLOY_MIN_AVAILABLE_MEMORY_MB=384
DEPLOY_MAX_BACKUP_MB=2048
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
OUTBOX_STALE_MINUTES=15
OUTBOX_STALE_MAX=10
OUTBOX_DEAD_LETTER_MAX=0
YINGCHUAN_BACKUP_RETENTION_COUNT=7

# Local dependency stack. These credentials are development-only.
COMPOSE_PROJECT_NAME=yingchuan
POSTGRES_DB=yingchuan
POSTGRES_USER=yingchuan
POSTGRES_PASSWORD=yingchuan_local_only
POSTGRES_PORT=55432
TEST_POSTGRES_DB=yingchuan_test
TEST_POSTGRES_USER=yingchuan_test
TEST_POSTGRES_PASSWORD=yingchuan_test_local_only
TEST_POSTGRES_PORT=55433
REDIS_PASSWORD=yingchuan_local_only
REDIS_PORT=56379
