generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  workspace
  platform
}

enum ModelFamily {
  doubao
  kimi
  glm
  deepseek
}

enum ApiMode {
  responses
  chat_completions
}

enum ConfigStatus {
  disabled
  enabled
}

enum ModelCallStatus {
  succeeded
  failed
}

enum UsageEntryType {
  grant
  reservation
  release
  debit
  adjustment
}

enum AnalysisJobStatus {
  queued
  running
  completed
  partially_completed
  failed
  cancelled
}

enum ModelRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
  outcome_unknown
}

enum RunAttemptStatus {
  running
  succeeded
  failed
  outcome_unknown
}

enum MentionKind {
  target
  competitor
  other
}

enum CompetitorStatus {
  candidate
  confirmed
  excluded
}

enum ReviewIssueStatus {
  open
  resolved
  ignored
}

enum ReportVersionStatus {
  generating
  ready
  published
  archived
  failed
}

enum RecommendationPriority {
  P0
  P1
  P2
  P3
}

enum AgentRunStatus {
  queued
  running
  succeeded
  failed
  budget_exceeded
}

enum AgentActionStatus {
  proposed
  executed
  rejected
  failed
}

enum LegalHoldScopeType {
  workspace
  project
}

enum DataLifecycleRunStatus {
  running
  completed
  failed
  dead_letter
}

enum NotificationDeliveryStatus {
  queued
  sending
  sent
  failed
}

enum AlertStatus {
  active
  resolved
}

enum AlertEvaluationRunStatus {
  running
  completed
  failed
  dead_letter
}

enum OperationsDailyReportStatus {
  running
  completed
  failed
  dead_letter
}

enum OutboxStatus {
  pending
  published
  dead_letter
}

enum AuthAudience {
  user
  admin
}

enum ChallengePurpose {
  login
  step_up
}

enum ChallengeStatus {
  pending
  consumed
  invalidated
}

enum UserStatus {
  active
  suspended
}

enum MembershipStatus {
  invited
  active
  removed
}

enum AuditOutcome {
  success
  denied
  failure
}

enum ProjectStatus {
  draft
  identifying
  waiting_confirmation
  ready
  active
  archived
}

enum OnboardingStatus {
  input_pending
  identification_queued
  identification_running
  confirmation_required
  completed
  failed
}

enum CandidateStatus {
  pending
  confirmed
  rejected
}

enum CandidateSource {
  user_input
  official_website
  model_native_search
  manual
}

enum AliasStatus {
  pending
  confirmed
  rejected
}

enum KnowledgeSourceType {
  official_website
  official_social
  public_profile
  model_reference
  other
}

enum KnowledgeSourceStatus {
  discovered
  confirmed
  rejected
  unavailable
  outdated
  needs_review
}

enum FetchJobStatus {
  queued
  running
  succeeded
  failed
  blocked
}

enum PromptCategory {
  brand_awareness
  recommendation
  comparison
  scenario
  product_or_service
  price
  trust
  location
  nearby
  store_specific
  alternative
  factual
}

enum PromptScope {
  global
  country
  province
  city
  district
  nearby
  store
}

enum PromptSource {
  manual
  generated
  imported
  variant
}

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @db.Uuid
  code        String    @db.VarChar(50)
  scope       RoleScope
  description String    @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int       @default(1)

  rolePermissions     RolePermission[]
  memberships         WorkspaceMembership[]
  invitations         WorkspaceInvitation[]
  platformAssignments PlatformRoleAssignment[]

  @@unique([scope, code])
  @@map("roles")
}

model User {
  id              String     @id @db.Uuid
  emailNormalized String     @unique @map("email_normalized") @db.VarChar(320)
  displayEmail    String     @map("display_email") @db.VarChar(320)
  status          UserStatus @default(active)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int        @default(1)

  monitoringSchedules   MonitoringSchedule[]
  optimizationCreated   OptimizationTask[]       @relation("OptimizationCreator")
  optimizationAssigned  OptimizationTask[]       @relation("OptimizationAssignee")
  sessions              AuthSession[]
  memberships           WorkspaceMembership[]
  invitationsCreated    WorkspaceInvitation[]    @relation("InvitationCreator")
  workspacesCreated     Workspace[]              @relation("WorkspaceCreator")
  projectsCreated       Project[]                @relation("ProjectCreator")
  brandVersions         BrandEntityVersion[]     @relation("BrandVersionCreator")
  sourcesConfirmed      KnowledgeSource[]        @relation("SourceConfirmer")
  promptsCreated        Prompt[]                 @relation("PromptCreator")
  promptVersions        PromptVersion[]          @relation("PromptVersionCreator")
  usageLedgerEntries    UsageLedgerEntry[]       @relation("UsageLedgerActor")
  analysisJobsCreated   AnalysisJob[]            @relation("AnalysisJobCreator")
  analysisJobsCancelled AnalysisJob[]            @relation("AnalysisJobCanceller")
  platformAssignments   PlatformRoleAssignment[]
  alertsAcknowledged    AlertEvent[]             @relation("AlertAcknowledgement")

  @@map("users")
}

model EmailCodeChallenge {
  id              String           @id @db.Uuid
  emailNormalized String           @map("email_normalized") @db.VarChar(320)
  codeHash        String           @map("code_hash") @db.Char(64)
  audience        AuthAudience
  purpose         ChallengePurpose
  status          ChallengeStatus  @default(pending)
  attempts        Int              @default(0)
  ipHash          String           @map("ip_hash") @db.Char(64)
  deviceHash      String           @map("device_hash") @db.Char(64)
  sessionId       String?          @map("session_id") @db.Uuid
  resendMessageId String?          @map("resend_message_id") @db.VarChar(150)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int              @default(1)

  session AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([emailNormalized, audience, purpose, status, createdAt])
  @@index([expiresAt])
  @@map("email_code_challenges")
}

model AuthSession {
  id            String       @id @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  tokenHash     String       @unique @map("token_hash") @db.Char(64)
  csrfHash      String       @map("csrf_hash") @db.Char(64)
  audience      AuthAudience
  origin        String       @db.VarChar(200)
  ipHash        String       @map("ip_hash") @db.Char(64)
  userAgentHash String       @map("user_agent_hash") @db.Char(64)
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  stepUpUntil   DateTime?    @map("step_up_until") @db.Timestamptz(3)
  revokedAt     DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version       Int          @default(1)

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges EmailCodeChallenge[]

  @@index([userId, audience, expiresAt])
  @@map("auth_sessions")
}

model PlatformRoleAssignment {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("platform_role_assignments")
}

model Workspace {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(80)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int      @default(1)

  createdBy          User                  @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships        WorkspaceMembership[]
  invitations        WorkspaceInvitation[]
  projects           Project[]
  usageLedgerEntries UsageLedgerEntry[]
  analysisJobs       AnalysisJob[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String           @id @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  roleId      String           @map("role_id") @db.Uuid
  status      MembershipStatus @default(active)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int              @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@map("workspace_memberships")
}

model WorkspaceInvitation {
  id              String           @id @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  emailNormalized String           @map("email_normalized") @db.VarChar(320)
  roleId          String           @map("role_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  status          MembershipStatus @default(invited)
  createdById     String           @map("created_by_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int              @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, emailNormalized, status])
  @@map("workspace_invitations")
}

model AuditLog {
  id             String       @id @db.Uuid
  actorType      String       @map("actor_type") @db.VarChar(30)
  actorId        String?      @map("actor_id") @db.Uuid
  actorEmailMask String?      @map("actor_email_mask") @db.VarChar(100)
  sessionId      String?      @map("session_id") @db.Uuid
  workspaceId    String?      @map("workspace_id") @db.Uuid
  action         String       @db.VarChar(150)
  objectType     String?      @map("object_type") @db.VarChar(100)
  objectId       String?      @map("object_id") @db.Uuid
  outcome        AuditOutcome
  riskLevel      String       @map("risk_level") @db.VarChar(20)
  requestId      String       @map("request_id") @db.VarChar(100)
  traceId        String       @map("trace_id") @db.Char(32)
  ipHash         String?      @map("ip_hash") @db.Char(64)
  beforeSummary  Json?        @map("before_summary")
  afterSummary   Json?        @map("after_summary")
  errorCode      String?      @map("error_code") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model RolePermission {
  id           String   @id @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Industry {
  id        String   @id @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version   Int      @default(1)

  projects Project[]

  @@map("industries")
}

model Project {
  id               String           @id @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  name             String           @db.VarChar(120)
  brandEntityId    String?          @unique @map("brand_entity_id") @db.Uuid
  industryId       String?          @map("industry_id") @db.Uuid
  defaultCountry   String           @default("CN") @map("default_country") @db.VarChar(2)
  defaultLanguage  String           @default("zh-CN") @map("default_language") @db.VarChar(20)
  timezone         String           @default("Asia/Shanghai") @db.VarChar(100)
  status           ProjectStatus    @default(draft)
  onboardingStatus OnboardingStatus @default(input_pending) @map("onboarding_status")
  archivedFrom     ProjectStatus?   @map("archived_from")
  createdById      String           @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  version          Int              @default(1)

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  industry            Industry?            @relation(fields: [industryId], references: [id], onDelete: Restrict)
  brandEntity         BrandEntity?         @relation(fields: [brandEntityId], references: [id], onDelete: Restrict)
  monitoringSchedules MonitoringSchedule[]
  optimizationTasks   OptimizationTask[]
  brandCandidates     BrandCandidate[]
  knowledgeSources    KnowledgeSource[]
  identificationJobs  IdentificationJob[]
  capabilities        ProjectCapability[]
  prompts             Prompt[]
  usageLedgerEntries  UsageLedgerEntry[]
  analysisJobs        AnalysisJob[]
  competitors         Competitor[]
  report              Report?

  @@index([workspaceId, status, createdAt])
  @@map("projects")
}

model Prompt {
  id                String         @id @db.Uuid
  projectId         String         @map("project_id") @db.Uuid
  text              String         @db.VarChar(1000)
  normalizedText    String         @map("normalized_text") @db.VarChar(1000)
  category          PromptCategory
  scope             PromptScope
  country           String?        @db.VarChar(2)
  province          String?        @db.VarChar(100)
  city              String?        @db.VarChar(100)
  district          String?        @db.VarChar(100)
  nearbyLandmark    String?        @map("nearby_landmark") @db.VarChar(200)
  targetStoreId     String?        @map("target_store_id") @db.Uuid
  language          String         @db.VarChar(20)
  source            PromptSource
  priority          Int            @default(50)
  enabled           Boolean        @default(true)
  groupKey          String?        @map("group_key") @db.VarChar(100)
  requiresWebSearch Boolean        @default(false) @map("requires_web_search")
  createdById       String         @map("created_by_id") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version           Int            @default(1)

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User            @relation("PromptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions  PromptVersion[]

  @@unique([projectId, normalizedText])
  @@index([projectId, enabled, category])
  @@index([projectId, groupKey])
  @@map("prompts")
}

model PromptVersion {
  id                String         @id @db.Uuid
  promptId          String         @map("prompt_id") @db.Uuid
  versionNumber     Int            @map("version_number")
  text              String         @db.VarChar(1000)
  normalizedText    String         @map("normalized_text") @db.VarChar(1000)
  category          PromptCategory
  scope             PromptScope
  country           String?        @db.VarChar(2)
  province          String?        @db.VarChar(100)
  city              String?        @db.VarChar(100)
  district          String?        @db.VarChar(100)
  nearbyLandmark    String?        @map("nearby_landmark") @db.VarChar(200)
  targetStoreId     String?        @map("target_store_id") @db.Uuid
  language          String         @db.VarChar(20)
  source            PromptSource
  priority          Int
  enabled           Boolean
  groupKey          String?        @map("group_key") @db.VarChar(100)
  requiresWebSearch Boolean        @default(false) @map("requires_web_search")
  changeReason      String         @map("change_reason") @db.VarChar(100)
  createdById       String         @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  prompt    Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdBy User       @relation("PromptVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  modelRuns ModelRun[]

  @@unique([promptId, versionNumber])
  @@index([createdById, createdAt])
  @@map("prompt_versions")
}

model ProjectCapability {
  id        String   @id @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  code      String   @db.VarChar(50)
  enabled   Boolean  @default(true)
  source    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code])
  @@map("project_capabilities")
}

model BrandEntity {
  id              String   @id @db.Uuid
  canonicalName   String   @map("canonical_name") @db.VarChar(160)
  normalizedName  String   @map("normalized_name") @db.VarChar(160)
  officialWebsite String?  @map("official_website") @db.VarChar(2048)
  country         String?  @db.VarChar(2)
  primaryLanguage String?  @map("primary_language") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int      @default(1)

  project  Project?
  aliases  BrandAlias[]
  versions BrandEntityVersion[]

  @@index([normalizedName, country])
  @@map("brand_entities")
}

model BrandAlias {
  id              String          @id @db.Uuid
  brandEntityId   String          @map("brand_entity_id") @db.Uuid
  value           String          @db.VarChar(160)
  normalizedValue String          @map("normalized_value") @db.VarChar(160)
  language        String?         @db.VarChar(20)
  source          CandidateSource
  status          AliasStatus     @default(confirmed)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int             @default(1)

  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)

  @@unique([brandEntityId, normalizedValue])
  @@map("brand_aliases")
}

model BrandEntityVersion {
  id              String   @id @db.Uuid
  brandEntityId   String   @map("brand_entity_id") @db.Uuid
  versionNumber   Int      @map("version_number")
  canonicalName   String   @map("canonical_name") @db.VarChar(160)
  normalizedName  String   @map("normalized_name") @db.VarChar(160)
  officialWebsite String?  @map("official_website") @db.VarChar(2048)
  country         String?  @db.VarChar(2)
  primaryLanguage String?  @map("primary_language") @db.VarChar(20)
  changeReason    String   @map("change_reason") @db.VarChar(100)
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  brandEntity BrandEntity @relation(fields: [brandEntityId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("BrandVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([brandEntityId, versionNumber])
  @@map("brand_entity_versions")
}

model IdentificationJob {
  id             String         @id @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  status         FetchJobStatus @default(queued)
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(200)
  attempts       Int            @default(0)
  maxAttempts    Int            @default(3) @map("max_attempts")
  timeoutMs      Int            @default(30000) @map("timeout_ms")
  errorCode      String?        @map("error_code") @db.VarChar(100)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  version        Int            @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("identification_jobs")
}

model BrandCandidate {
  id              String          @id @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  displayName     String          @map("display_name") @db.VarChar(160)
  normalizedName  String          @map("normalized_name") @db.VarChar(160)
  officialWebsite String?         @map("official_website") @db.VarChar(2048)
  country         String?         @db.VarChar(2)
  confidence      Decimal         @db.Decimal(5, 4)
  source          CandidateSource
  citationUrl     String?         @map("citation_url") @db.VarChar(2048)
  status          CandidateStatus @default(pending)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version         Int             @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, normalizedName, officialWebsite])
  @@index([projectId, status])
  @@map("brand_candidates")
}

model KnowledgeSource {
  id                      String                @id @db.Uuid
  projectId               String                @map("project_id") @db.Uuid
  type                    KnowledgeSourceType
  originalUrl             String                @map("original_url") @db.VarChar(2048)
  normalizedUrl           String                @map("normalized_url") @db.VarChar(2048)
  status                  KnowledgeSourceStatus @default(discovered)
  confirmedById           String?               @map("confirmed_by_id") @db.Uuid
