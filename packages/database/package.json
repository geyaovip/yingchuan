{
  "name": "@yingchuan/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "db:fixtures:test": "NODE_ENV=test tsx prisma/fixtures/test.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://yingchuan_test:yingchuan_test_local_only@127.0.0.1:55433/yingchuan_test?schema=public} prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3",
    "prisma": "^7.9.0"
  }
}
