api.chatway.chat {
	encode zstd gzip

	handle /api/v1/metrics {
		respond 404
	}

	# Shared APaaS APIs: strip the gateway prefix before forwarding.
	handle_path /apaas-sales360/* {
		reverse_proxy apaas-sales360-crm-api:4301
	}
	handle_path /apaas-mes/* {
		reverse_proxy apaas-mes-api:4401
	}
	handle_path /apaas-erp/* {
		reverse_proxy apaas-electronics-erp-api:4501
	}

	handle {
		reverse_proxy api:3000 {
			health_uri /api/v1/ready
			health_status 200
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
}
